<Window x:Class="ISLA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ISLA"
        Icon="Icon.png"
        Width="580"
        Height="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Focusable="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        SourceInitialized="MainWindow_SourceInitialized"
        Closing="Window_Closing">

    <!--
        The OS window is a FIXED, fully transparent canvas (clicks pass through the transparent
        parts). Only IslandSurface changes size, so no per-frame window resizing = smooth.
    -->
    <Grid>
        <Border x:Name="IslandSurface"
                Width="180"
                Height="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource IslandBackground}"
                CornerRadius="15"
                Padding="5,0"
                ClipToBounds="True"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave">

            <Grid>
                <!-- ============ COMPACT ============ -->
                <Grid x:Name="CompactContent"
                      Width="170"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0"
                      UseLayoutRounding="True">
                    <!-- Ring (left, flush to the edge) + percentage (right) -->
                    <Grid x:Name="CompactBatteryContent"
                          Height="22"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center">
                        <Grid Width="22"
                              Height="22"
                              HorizontalAlignment="Left">
                            <Ellipse Stroke="#38383D" StrokeThickness="3" />
                            <Path x:Name="CompactBatteryRing"
                                  Stroke="#38D46A"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path x:Name="CompactChargingIcon"
                                  Data="M 11,1 L 5,12 L 10,12 L 8,21 L 17,9 L 12,9 L 14,1 Z"
                                  Fill="#F7F7F7"
                                  Width="9" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="CompactBatteryPercentText"
                                   Style="{StaticResource CompactPercentStyle}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   Text="--%" />
                        <!-- Mini spectrum: replaces the percentage while media is playing -->
                        <StackPanel x:Name="CompactSpectrum"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                            <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="1" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ClockText"
                               Text="00:00"
                               Style="{StaticResource ClockStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <!-- Idle-notch spectrum (right of the clock while media is playing) -->
                    <StackPanel x:Name="IdleSpectrum"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Height="9"
                                Margin="0,0,12,0"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                        <Rectangle Width="1.6" Height="9" RadiusX="0.8" RadiusY="0.8" Margin="0.8,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Width="1.6" Height="9" RadiusX="0.8" RadiusY="0.8" Margin="0.8,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Width="1.6" Height="9" RadiusX="0.8" RadiusY="0.8" Margin="0.8,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="1" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Width="1.6" Height="9" RadiusX="0.8" RadiusY="0.8" Margin="0.8,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Width="1.6" Height="9" RadiusX="0.8" RadiusY="0.8" Margin="0.8,0" Fill="{StaticResource IslandText}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>
                    <Grid x:Name="NodeNotificationContent"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="300">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock x:Name="NodeNotificationAppText"
                                       Style="{StaticResource ContentSubtitleStyle}"
                                       Foreground="{StaticResource IslandText}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NodeNotificationText"
                                       Style="{StaticResource ContentSubtitleStyle}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ EXPANDED ============
                     Fixed width/height (set from code) so the layout never reflows while the
                     island grows or shrinks around it. -->
                <Grid x:Name="ExpandedContent"
                      Visibility="Collapsed"
                      Width="484"
                      Height="280"
                      Margin="0,0,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ExpandedTranslate" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <Grid Margin="0,0,0,2" Height="34">
                        <TextBlock Text="ISLA"
                                   Style="{StaticResource BrandStyle}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTip="Close"
                                Click="CloseButton_Click"
                                Style="{StaticResource GhostIconButtonStyle}">
                            <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- content area -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ===== MEDIA PANEL ===== -->
                        <StackPanel x:Name="MediaPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Now playing" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock x:Name="MediaStatusText"
                                           Grid.Column="1"
                                           Text="Checking media sessions..."
                                           Style="{StaticResource MetadataStyle}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0,0,0" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Album art (placeholder note icon until a cover is available) -->
                                <Border Width="62" Height="62"
                                        CornerRadius="12"
                                        Background="{StaticResource IslandCard}"
                                        BorderBrush="{StaticResource IslandBorder}"
                                        BorderThickness="1"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Path Data="M 7,15.5 L 7,4 L 15,2.5 L 15,14 M 7,15.5 A 2.5,2.5 0 1 1 2,15.5 A 2.5,2.5 0 1 1 7,15.5 M 15,14 A 2.5,2.5 0 1 1 10,14 A 2.5,2.5 0 1 1 15,14"
                                              Stroke="{StaticResource IslandMutedText}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              Width="22" Height="22" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="MediaCoverImage"
                                               Width="60" Height="60"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,60,60" RadiusX="11" RadiusY="11" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaTitleText"
                                               Text="No active media session"
                                               Style="{StaticResource ContentTitleStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="MediaArtistText"
                                               Text="Play media in Spotify or a supported browser"
                                               Style="{StaticResource ContentSubtitleStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                    <TextBlock x:Name="MediaAlbumText"
                                               Style="{StaticResource MetadataStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Click or drag to seek -->
                            <Grid x:Name="MediaSeekArea"
                                  Height="16"
                                  Margin="0,6,0,0"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  MouseEnter="MediaSeek_MouseEnter"
                                  MouseLeave="MediaSeek_MouseLeave"
                                  MouseLeftButtonDown="MediaSeek_MouseDown"
                                  MouseMove="MediaSeek_MouseMove"
                                  MouseLeftButtonUp="MediaSeek_MouseUp">
                                <ProgressBar x:Name="MediaProgress"
                                             Height="4"
                                             Minimum="0" Maximum="1"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False" />
                            </Grid>

                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="MediaPositionText" DockPanel.Dock="Left"
                                           Text="0:00" Style="{StaticResource TimeLabelStyle}" />
                                <TextBlock x:Name="MediaDurationText" DockPanel.Dock="Right"
                                           Text="0:00" Style="{StaticResource TimeLabelStyle}" />
                            </DockPanel>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Button Tag="Previous" ToolTip="Previous track"
                                        Click="MediaControl_Click"
                                        Style="{StaticResource IconButtonStyle}">
                                    <Path Data="M 3,3 L 5,3 L 5,13 L 3,13 Z M 14,3 L 6.5,8 L 14,13 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                          StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>

                                <Button Grid.Column="1"
                                        x:Name="PlayPauseButton"
                                        Tag="PlayPause" ToolTip="Play or pause"
                                        Click="MediaControl_Click"
                                        Style="{StaticResource PrimaryIconButtonStyle}">
                                    <Grid>
                                        <Path x:Name="PlayIcon"
                                              Data="M 4,2 L 14,8 L 4,14 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              StrokeThickness="1.6" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="PauseIcon"
                                              Data="M 3,2 L 6,2 L 6,14 L 3,14 Z M 10,2 L 13,2 L 13,14 L 10,14 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              StrokeThickness="1.4" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Opacity="0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>

                                <Button Grid.Column="2" Tag="Next" ToolTip="Next track"
                                        Click="MediaControl_Click"
                                        Style="{StaticResource IconButtonStyle}">
                                    <Path Data="M 2,3 L 9.5,8 L 2,13 Z M 11,3 L 13,3 L 13,13 L 11,13 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                          StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- ===== SETTINGS PANEL ===== -->
                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="Quick Settings" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock Text="System controls" Style="{StaticResource ContentTitleStyle}" Margin="0,4,0,0" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <!-- Volume -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Volume" Style="{StaticResource CardLabelStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="VolumeValueText"
                                                       Grid.Column="1"
                                                       Style="{StaticResource CardValueSmallStyle}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <Path HorizontalAlignment="Right"
                                                  Grid.Column="2"
                                                  Data="M 2,6 L 5,6 L 9,3 L 9,13 L 5,10 L 2,10 Z M 11,6 A 3,3 0 0 1 11,10"
                                                  Stroke="{StaticResource IslandMutedText}"
                                                  StrokeThickness="1.2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </Grid>
                                        <Slider x:Name="VolumeSlider"
                                                Minimum="0" Maximum="1"
                                                ValueChanged="VolumeSlider_ValueChanged"
                                                Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Battery -->
                                <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Margin="0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Battery" Style="{StaticResource CardLabelStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="BatteryValueText"
                                                       Grid.Column="1"
                                                       Style="{StaticResource CardValueSmallStyle}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <Path x:Name="BatteryCardIcon"
                                                  HorizontalAlignment="Right"
                                                  Grid.Column="2"
                                                  Data="M 3.5,3.5 L 13,3.5 A 1.5,1.5 0 0 1 14.5,5 L 14.5,11 A 1.5,1.5 0 0 1 13,12.5 L 3.5,12.5 A 1.5,1.5 0 0 1 2,11 L 2,5 A 1.5,1.5 0 0 1 3.5,3.5 Z M 16.5,7 L 16.5,9"
                                                  Stroke="{StaticResource IslandAccent}"
                                                  StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="18" Height="12" Stretch="Uniform" />
                                        </Grid>
                                        <TextBlock x:Name="PowerStatusText"
                                                   Style="{StaticResource CardHintStyle}"
                                                   FontSize="11"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <!-- Wi-Fi -->
                                <Button Click="RadioToggle_Click" Tag="WiFi"
                                        Style="{StaticResource SettingsMiniCardButtonStyle}">
                                    <Border Style="{StaticResource SettingsMiniCardStyle}">
                                    <DockPanel>
                                        <Grid Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,8,0">
                                            <Path Data="M 1,6 A 10,10 0 0 1 15,6 M 3.5,9 A 7,7 0 0 1 12.5,9 M 6,12 A 4,4 0 0 1 10,12"
                                                  Stroke="{StaticResource IslandAccent}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="Uniform" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Wi-Fi" Style="{StaticResource CardLabelStyle}" />
                                            <TextBlock x:Name="WiFiStatusText" Style="{StaticResource CardValueSmallStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                                </Button>

                                <!-- Bluetooth -->
                                <Button Grid.Column="1" Click="RadioToggle_Click" Tag="Bluetooth"
                                        Style="{StaticResource SettingsMiniCardButtonStyle}">
                                    <Border Style="{StaticResource SettingsMiniCardStyle}" Margin="0">
                                    <DockPanel>
                                        <Grid Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,8,0">
                                            <Path Data="M 5,1 L 5,15 L 10,10 L 2,4 M 2,12 L 10,6 L 5,1"
                                                  Stroke="{StaticResource IslandAccent}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="Uniform" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Bluetooth" Style="{StaticResource CardLabelStyle}" />
                                            <TextBlock x:Name="BluetoothStatusText" Style="{StaticResource CardValueSmallStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                                </Button>
                            </Grid>

                            <!-- Brightness -->
                            <Border Style="{StaticResource SettingsWideCardStyle}" Margin="0,6,0,0">
                                <DockPanel>
                                    <Path Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 Z M 8,4 A 4,4 0 1 1 8,12 A 4,4 0 1 1 8,4 Z"
                                          Fill="{StaticResource IslandMutedText}"
                                          Width="14" Height="14" Stretch="Uniform"
                                          DockPanel.Dock="Left" Margin="0,0,12,0" />
                                    <TextBlock x:Name="BrightnessValueText" Text="--"
                                               Style="{StaticResource CardValueSmallStyle}"
                                               DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100"
                                            ValueChanged="BrightnessSlider_ValueChanged"
                                            VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                            </Border>

                            <TextBlock x:Name="SettingsStatusText"
                                       Style="{StaticResource StatusTextStyle}"
                                       Margin="2,6,0,0" />
                        </StackPanel>

                        <!-- ===== WI-FI / BLUETOOTH DETAIL PANEL ===== -->
                        <StackPanel x:Name="RadioPanel" Visibility="Collapsed">
                            <Grid Height="30">
                                <Button HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        ToolTip="Back"
                                        Click="RadioBack_Click"
                                        Style="{StaticResource GhostIconButtonStyle}">
                                    <Path Data="M 7,1 L 2,6 L 7,11 M 2,6 L 12,6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                                <TextBlock x:Name="RadioTitleText"
                                           Text="Wi-Fi"
                                           Style="{StaticResource ContentTitleStyle}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="34,0,0,0" />
                                <ToggleButton x:Name="RadioSwitch"
                                              Style="{StaticResource IslandSwitchStyle}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Click="RadioSwitch_Click" />
                            </Grid>
                            <TextBlock x:Name="RadioSubtitleText"
                                       Style="{StaticResource MetadataStyle}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="2,2,0,6" />
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="4">
                                <ScrollViewer Height="100"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel x:Name="RadioList" />
                                </ScrollViewer>
                            </Border>
                            <Button Click="RadioSettingsLink_Click"
                                    Style="{StaticResource RadioRowButtonStyle}"
                                    Height="22"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Right">
                                <TextBlock x:Name="RadioSettingsLinkText"
                                           Text="Network settings"
                                           Style="{StaticResource MetadataStyle}"
                                           Foreground="{StaticResource IslandAccent}"
                                           FontSize="11" />
                            </Button>
                        </StackPanel>

                        <!-- ===== TIMER PANEL ===== -->
                        <StackPanel x:Name="TimerPanel" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="Focus timer" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="PomodoroTimeText"
                                       Text="25:00"
                                       Style="{StaticResource DisplayTimeStyle}"
                                       Margin="-2,4,0,0" />
                            <TextBlock x:Name="PomodoroPhaseText"
                                       Text="Focus session"
                                       Style="{StaticResource PhaseLabelStyle}" />

                            <Grid                             Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PomodoroStartButton"
                                        Click="PomodoroStartButton_Click"
                                        ToolTip="Start or pause timer"
                                        Style="{StaticResource PrimaryIconButtonStyle}">
                                    <Grid>
                                        <Path x:Name="PomodoroPlayIcon"
                                              Data="M 4,2 L 14,8 L 4,14 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              StrokeThickness="1.6" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="PomodoroPauseIcon"
                                              Data="M 3,2 L 6,2 L 6,14 L 3,14 Z M 10,2 L 13,2 L 13,14 L 10,14 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              StrokeThickness="1.4" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Opacity="0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>

                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Click="PomodoroResetButton_Click"
                                        ToolTip="Reset timer"
                                        Style="{StaticResource IconButtonStyle}">
                                    <Path Data="M 13,5 A 5,5 0 1 0 13,10 M 13,2 L 13,6 L 9,6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="16" Height="16" Stretch="Uniform" />
                                </Button>

                                <TextBlock x:Name="PomodoroSessionsText"
                                           Grid.Column="2"
                                           Text="Sessions: 0"
                                           Style="{StaticResource MetadataStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock x:Name="PomodoroStatusText"
                                       Style="{StaticResource MetadataStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- ===== DOCK ===== -->
                        <Border Grid.Row="1"
                                Background="{StaticResource IslandDock}"
                                BorderBrush="{StaticResource IslandBorder}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="6,4"
                                Margin="0,4,0,2"
                                HorizontalAlignment="Center">
                            <Grid>
                                <!-- sliding highlight behind the active tab (slot width = 38) -->
                                <Border x:Name="DockPill"
                                        Width="28" Height="22"
                                        CornerRadius="9"
                                        Background="{StaticResource IslandPill}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="1,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="DockPillTransform" X="0" />
                                    </Border.RenderTransform>
                                </Border>

                                <UniformGrid Columns="3">
                                    <RadioButton Tag="Media" GroupName="IslandDock" IsChecked="True"
                                                 Checked="TabButton_Click" ToolTip="Media"
                                                 Style="{StaticResource DockButtonStyle}">
                                        <Path Data="M 6,2 L 8,2 L 8,14 L 6,14 Z M 10,4 L 12,4 L 12,14 L 10,14 Z M 3,6 L 4,6 L 4,14 L 3,14 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              StrokeThickness="1" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" />
                                    </RadioButton>

                                    <RadioButton Tag="Settings" GroupName="IslandDock"
                                                 Checked="TabButton_Click" ToolTip="Quick settings"
                                                 Style="{StaticResource DockButtonStyle}">
                                        <Path Data="M 2,3 L 14,3 M 2,8 L 14,8 M 2,13 L 14,13 M 5,1 L 5,5 M 11,6 L 11,10 M 7,11 L 7,15"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="13" Height="13" Stretch="Uniform" />
                                    </RadioButton>

                                    <RadioButton Tag="Timer" GroupName="IslandDock"
                                                 Checked="TabButton_Click" ToolTip="Pomodoro timer"
                                                 Style="{StaticResource DockButtonStyle}">
                                        <Grid Width="13" Height="13">
                                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                     StrokeThickness="1.5" />
                                            <Path Data="M 8,4 L 8,8 L 11,10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="6" Height="6" Stretch="Fill" />
                                        </Grid>
                                    </RadioButton>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Idle notch battery indicator: lives OUTSIDE IslandSurface so the surface's
             size animation / ClipToBounds can never cut it. Fixed notch size, shown only
             once the notch has finished shrinking. -->
        <Path x:Name="IdleBatteryTrack"
              Visibility="Collapsed"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Stroke="#000000"
              StrokeThickness="1"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Flat"
              StrokeEndLineCap="Flat"
              Fill="Transparent"
              IsHitTestVisible="False" />
        <Path x:Name="IdleBatteryEdge"
              Visibility="Collapsed"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Stroke="#38D46A"
              StrokeThickness="1"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Flat"
              StrokeEndLineCap="Flat"
              Fill="Transparent"
              IsHitTestVisible="False" />
    </Grid>
</Window>
