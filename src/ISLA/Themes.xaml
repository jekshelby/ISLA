<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ===== Brushes (frozen = cheaper to render) ===== -->
    <SolidColorBrush x:Key="IslandBackground"    Color="#050505" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandSurface"       Color="#0B0B0B" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandCard"          Color="#0F0F10" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandCardHover"     Color="#161618" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandBorder"        Color="#1E1E20" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandText"          Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandTextSecondary" Color="#C4C4C8" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandMutedText"     Color="#8B8B8B" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandAccent"        Color="#86A9FF" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandTrack"         Color="#222226" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandDock"          Color="#0A0A0B" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandPill"          Color="#1B1B1E" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandHoverOverlay"       Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="IslandHoverOverlayStrong" Color="#26FFFFFF" po:Freeze="True" />

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Brand / header -->
    <Style x:Key="BrandStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Compact clock -->
    <Style x:Key="ClockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Battery percentage shown at the right edge of the compact island -->
    <Style x:Key="CompactPercentStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Small section label ("Now playing", "Quick Settings", ...) -->
    <Style x:Key="EyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Main title (track name, panel heading) -->
    <Style x:Key="ContentTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Secondary line (artist) – softer than the title for clear hierarchy -->
    <Style x:Key="ContentSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Tertiary info (album, status) -->
    <Style x:Key="MetadataStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Elapsed / total time -->
    <Style x:Key="TimeLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Settings footer / long status messages -->
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="CardValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardValueSmallStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="CardHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Big timer digits -->
    <Style x:Key="DisplayTimeStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>

    <Style x:Key="PhaseLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== Buttons =====
         Hover  : a white overlay fades in/out (no hard colour switch)
         Pressed: the button squashes slightly and springs back
         The overlay colour comes from BorderBrush so Primary can reuse the same template. -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource IslandText}" />
        <Setter Property="Background" Value="{StaticResource IslandCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource IslandHoverOverlay}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="Hover"
                                    Background="{TemplateBinding BorderBrush}"
                                    CornerRadius="14"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.92" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.92" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Background" Value="{StaticResource IslandAccent}" />
        <Setter Property="Foreground" Value="#0A0A0A" />
        <Setter Property="BorderBrush" Value="{StaticResource IslandHoverOverlayStrong}" />
    </Style>

    <!-- Small borderless button (close) -->
    <Style x:Key="GhostIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IslandHoverOverlay}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="Hover"
                                    Background="{TemplateBinding BorderBrush}"
                                    CornerRadius="9"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource IslandText}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dock tab button. RadioButton so the active tab is tracked for free
         (the sliding highlight pill lives in MainWindow.xaml). -->
    <Style x:Key="DockButtonStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Foreground" Value="{StaticResource IslandMutedText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IslandHoverOverlay}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="9"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="Hover"
                                    Background="{TemplateBinding BorderBrush}"
                                    CornerRadius="9"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource IslandText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource IslandText}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== On/off switch (Wi-Fi / Bluetooth panel) ===== -->
    <Style x:Key="IslandSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border Background="{StaticResource IslandTrack}" CornerRadius="10" />
                        <Border x:Name="OnTrack" Background="{StaticResource IslandAccent}" CornerRadius="10" Opacity="0" />
                        <Ellipse Width="14" Height="14"
                                 Fill="{StaticResource IslandText}"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row in the Wi-Fi / Bluetooth list -->
    <Style x:Key="RadioRowButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHoverOverlay}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource IslandHoverOverlayStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ProgressBar (implicit) ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource IslandTrack}" />
        <Setter Property="Foreground" Value="{StaticResource IslandAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider (implicit) =====
         - 20px tall hit area (the visible track is still 4px)
         - thumb grows on hover and a little more while dragging -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2"
                                Background="{StaticResource IslandTrack}"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{StaticResource IslandAccent}"
                                                        VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                                                </Grid.RenderTransform>
                                                <Ellipse Fill="{StaticResource IslandText}"
                                                         Stroke="{StaticResource IslandBackground}"
                                                         StrokeThickness="2" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.15" Duration="0:0:0.14" />
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.15" Duration="0:0:0.14" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.28" Duration="0:0:0.1" />
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.28" Duration="0:0:0.1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cards ===== -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource IslandCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource IslandBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="SettingsWideCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="SettingsMiniCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="SettingsMiniCardButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
