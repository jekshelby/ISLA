<Project>
  <PropertyGroup>
    <!--
      Single source of truth for the product version.
      Must stay numeric (X.Y.Z): the packaging script appends .0 for the
      four-part MSIX identity version, and AssemblyVersion needs four parts.
    -->
    <Version>1.5.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Company>ISLA Development</Company>
    <Product>ISLA</Product>
  </PropertyGroup>
</Project>
