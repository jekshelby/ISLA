<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ISLA-Installer</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="logo.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ISLA-payload.zip" />
    <EmbeddedResource Include="ISLA.Identity.msix" />
    <EmbeddedResource Include="ISLA.Identity.cer" />
  </ItemGroup>

  <!--
    The payload, identity package and certificate are generated by build-installer.ps1.
    Fail early with an actionable message instead of producing an installer without them.
  -->
  <Target Name="EnsureInstallerResources"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\ISLA-payload.zip')"
           Text="Installer payload is missing. Run .\build-installer.ps1 from the repository root before building the installer." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\ISLA.Identity.msix')"
           Text="Notification identity package is missing. Run .\build-installer.ps1 from the repository root before building the installer." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\ISLA.Identity.cer')"
           Text="Notification identity certificate is missing. Run .\build-installer.ps1 from the repository root before building the installer." />
  </Target>
</Project>
